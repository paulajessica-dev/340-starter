<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      background-color: #f5f5f5;
    }
    .notice {
      background-color: #d4edda;
      color: #155724;
      padding: 10px;
      border-radius: 5px;
      margin-bottom: 20px;
    }
    .favorite-list {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }
    .favorite-item {
      background-color: #fff;
      padding: 15px;
      border-radius: 5px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      width: 200px;
      text-align: center;
    }
    .favorite-item img {
      max-width: 100%;
      border-radius: 5px;
    }
    .favorite-item h3 {
      font-size: 1rem;
      margin: 10px 0 5px 0;
    }
    .favorite-item p {
      font-size: 0.9rem;
      margin: 5px 0;
    }
  </style>
</head>
<body>
      <h1 class="textName"><%= title %></h1>

      <% if (messages.notice) { %>
        <div class="notice"><%= messages.notice %></div>
      <% } %>

      <% if (favorites && favorites.length > 0) { %>
        <div class="favorite-list">
          <% favorites.forEach(fav => { %>
            <div class="favorite-item">
              <img src="<%= fav.inv_image %>" alt="<%= fav.inv_make %> <%= fav.inv_model %>">
              <h3><%= fav.inv_make %> <%= fav.inv_model %></h3>
              <p>Year: <%= fav.inv_year %></p>
              <p>Price: $<%= new Intl.NumberFormat('en-US').format(fav.inv_price) %></p>
              <form action="/favorite/deletevehicle" method="POST">
                <input type="hidden" name="inv_id" value="<%= fav.inv_id %>">
                <button type="submit">Remove from Favorites</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p>You have no favorites yet.</p>
      <% } %>
      
  </body>
</html>
