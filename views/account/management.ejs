<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    main {
        display: flex;
        justify-content: left;
        align-items: center;
        padding: 35px;
    }

    body {      
      padding: 0.5rem;      
      justify-content: center;
      align-items: center;      
      margin: 0;
      background-color: #f5f5f5;
    }
    

    h1 {
      font-size: 1.8rem;
      color: #970b0e;
      margin-bottom: 1.5rem;
    }

    h2 {
      font-size: 1.2rem;      
      margin-bottom: 1.5rem;
    }

    
    .link {
      margin-top: 1rem;
      display: block;
      font-size: 1.5rem;
      color: #333;
    }

    .link:hover {
      text-decoration: underline;
    }

    ul, li {
      list-style: none;
    }


  </style>
</head>
<body>

  <div class="management-container">
    <h1><%= title %></h1>
    <h2>Welcome Basic</h2>
    <% if (messages.notice && messages.notice.length > 0) { %>
      <p><%= messages.notice[0] %></p>
    <% } %>

    <p>You're Logged in</p>   
    
    <h3><a class="link" href="/account/editregister/<%= account_id %>">Update Account Information</a></h3>
    <h3><a class="link" href="/favorite/<%= account_id %>">See Favorited Vehicles</a></h3>
    
  </div>

</body>
</html>
