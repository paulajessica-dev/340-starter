<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    main {
        display: flex;
        justify-content: left;
        align-items: center;
        padding: 35px;
    }

    body {      
      padding: 0.5rem;      
      justify-content: center;
      align-items: center;      
      margin: 0;
      background-color: #f5f5f5;
    }
    

    h1 {
      font-size: 1.8rem;
      color: #970b0e;
      margin-bottom: 1.5rem;
    }
    
    .link {
      margin-top: 1rem;
      display: block;
      font-size: 1.5rem;
      color: #333;
    }

    .link:hover {
      text-decoration: underline;
    }

  </style>
</head>
<body>

  <div class="inv-container">
    <%- messages() %>
    <h1><%= title %></h1>
    
    <a class="link" href="/inv/addclassification">Add New Classification</a>
    <a class="link" href="/inv/addvehicle">Add New Vehicle</a>
  </div>

</body>
</html>
